# Versions and checksums of the downloads build.yml pins. Plain KEY=value
# lines, read into the job environment by build.yml and kept current by
# .github/scripts/upstream.py (workflow files cannot be pushed by the
# workflow token, so the automation only edits this file).
#
# libmpv for Linux with FFmpeg, libplacebo and their libraries inside it,
# built on Ubuntu 22.04 from mpv master by lumtub-media-builds' GitHub
# Actions (baseline x86_64, x86_64-v3 and aarch64). Pinned by checksum.
MPV_RELEASE=libmpv-20261121-d11ffba25
MPV_SHA256_X86_64=1d072ae7fb40e74b1b6009120e4201496c4e7e50682d864d9b917773848a1b70
MPV_SHA256_X86_64_V3=4f892b2dbf5a74a779e8cc058a55ebe1804ce7c75dc2d5c467b9bbdb6169cfdc
MPV_SHA256_AARCH64=136ebf6a0473ad5c6e56149421efcc9d7f6f372208aee9fd9076671ba8b0ea39
# libmpv for iOS with the picture-in-picture video output, built by
# lumtub-media-builds from vendor/media_kit_libs_ios_video/ios (its name
# carries the recipe's hash; build.yml builds a recipe not released yet).
IOS_LIBMPV_RELEASE=libmpv-ios-1.1.0-n9.0.2-9bec80a76d
IOS_LIBMPV_SHA256=b8e65e8d81cbd63d82e42ef164e81569c45c0f8cab0d48efece7a3f391b4fd14
# ANGLE for Windows on Arm, vcpkg's angle port built by lumtub-media-builds
# (release angle-arm64-windows-<port version>). none = vcpkg builds it.
ANGLE_ARM64_RELEASE=angle-arm64-windows-chromium_7258-2
ANGLE_ARM64_SHA256=70c855fd367f711a2e258ec1ada74f4be1c3440ba41bf77b2752c868d01bae16
# An LGPL ffmpeg from https://github.com/dfloresc/ffmpeg-macos-builds that
# makes the macOS smoke test's video (the app carries none); sum from its
# SHA256SUMS.
FFMPEG_RELEASE=v9.0.1-1
FFMPEG_ARM64_SHA256=d0ea5ea43a5adfa5d01d4137c9e5a61728b800a812f12917a26fd7af0c14c03a
# appimagetool, by release and the checksum of each build.
APPIMAGETOOL_VERSION=1.9.1
APPIMAGETOOL_SHA256_X86_64=ed4ce84f0d9caff66f50bcca6ff6f35aae54ce8135408b3fa33abfc3cb384eb0
APPIMAGETOOL_SHA256_AARCH64=f0837e7448a0c1e4e650a93bb3e85802546e60654ef287576f46c71c126a9158
# Python for Android: CPython's own Android release from python.org
# (python-<version>-<host>.tar.gz, PSF licence, built with OpenSSL, SQLite,
# libffi, xz, bzip2 and zstd; no readline or gdbm). The app's yt-dlp runs on
# it (android/packaging/python.sh). CPython has no 32-bit Arm build. The
# sums are of the tarballs; "unpinned" makes the script print the sum.
PYTHON_ANDROID_VERSION=3.14.0
PYTHON_ANDROID_SHA256_ARM64=f09bd8ae86f408580881ae224e848805c267bb65b3111dc77b41bda79456da6c
PYTHON_ANDROID_SHA256_X86_64=unpinned
# The yt-dlp zip app the APK carries until the app's own update check
# fetches a newer one: a stable release, checked against this sum and
# against that release's SHA2-256SUMS.
YTDLP_VERSION=2026.10.26
YTDLP_SHA256=e51e69e89489f199530f13d32a4342da3ddb2cf34842f364603a066db05afbf3
