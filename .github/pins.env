# Versions and checksums of the downloads build.yml pins. Plain KEY=value
# lines, read into the job environment by build.yml and kept current by
# .github/scripts/upstream.py (workflow files cannot be pushed by the
# workflow token, so the automation only edits this file).
#
# libmpv for Linux with FFmpeg, libplacebo and their libraries inside it,
# built on Ubuntu 22.04 from mpv master by lumtub-media-builds' GitHub
# Actions (baseline x86_64, x86_64-v3 and aarch64). Pinned by checksum.
MPV_RELEASE=libmpv-20261124-35efcf53d
MPV_SHA256_X86_64=a968c42482d75b92a0da8412c46fc2733473e845d2fa373dc76ec4b60702fec9
MPV_SHA256_X86_64_V3=f13b56825b498b5557ca1cef1151523316242905996c15cc8b621053a2bf5a80
MPV_SHA256_AARCH64=c46962c6fc13dbf1a542b8b67a62a9f6113d399af89aa13c647a9bdc4b134a01
# libmpv for iOS with the picture-in-picture video output, built by
# lumtub-media-builds from vendor/media_kit_libs_ios_video/ios (its name
# carries the recipe's hash; build.yml builds a recipe not released yet).
IOS_LIBMPV_RELEASE=libmpv-ios-1.1.0-n9.0.2-9c6439287c
IOS_LIBMPV_SHA256=6f0e1f421ca14a9b1d4c8398ee86e79ae07f99fb38528ef6a02db3cb1070be36
# ANGLE for Windows on Arm, vcpkg's angle port built by lumtub-media-builds
# (release angle-arm64-windows-<port version>). none = vcpkg builds it.
ANGLE_ARM64_RELEASE=angle-arm64-windows-chromium_7258-2
ANGLE_ARM64_SHA256=70c855fd367f711a2e258ec1ada74f4be1c3440ba41bf77b2752c868d01bae16
# An LGPL ffmpeg from https://github.com/dfloresc/ffmpeg-macos-builds that
# makes the macOS smoke test's video (the app carries none); sum from its
# SHA256SUMS.
FFMPEG_RELEASE=v9.0.1-1
FFMPEG_ARM64_SHA256=d0ea5ea43a5adfa5d01d4137c9e5a61728b800a812f12917a26fd7af0c14c03a
# appimagetool, by release and the checksum of each build.
APPIMAGETOOL_VERSION=1.9.1
APPIMAGETOOL_SHA256_X86_64=ed4ce84f0d9caff66f50bcca6ff6f35aae54ce8135408b3fa33abfc3cb384eb0
APPIMAGETOOL_SHA256_AARCH64=f0837e7448a0c1e4e650a93bb3e85802546e60654ef287576f46c71c126a9158
# A desktop CPython with the same PyInitConfig calls as the iOS framework,
# for the core's python.rs start-up test on Linux (checks.yml): Astral's
# python-build-standalone build, release tag, file and its SHA256SUMS line.
PYTHON_TEST_RELEASE=20260718
PYTHON_TEST_FILE=cpython-3.14.6+20260718-x86_64-unknown-linux-gnu-install_only_stripped.tar.gz
PYTHON_TEST_SHA256=86bf107f65fc30b56f2b263b26797fcbb1661f5315910cdbf27f733eb8738b74
# Python for Android: CPython's own Android release from python.org
# (python-<version>-<host>.tar.gz, PSF licence, built with OpenSSL, SQLite,
# libffi, xz, bzip2 and zstd; no readline or gdbm). The app's yt-dlp runs on
# it (android/packaging/python.sh). The sums are of the tarballs;
# "unpinned" makes the script print the sum.
PYTHON_ANDROID_VERSION=3.14.10
PYTHON_ANDROID_SHA256_ARM64=423c80b957330cf0ebb92b9b20f2294c292144a441bdb0ceb8c69d14928e569b
PYTHON_ANDROID_SHA256_X86_64=6ebda1fc3f28efc5861cad397254e8ce5d81ba4f83a3cb6a0c124c3826a0e14c
# python.org publishes no 32-bit Arm build, so armeabi-v7a gets one built
# by CPython's own Android/android.py (android/packaging/python-arm32.sh)
# from this commit of the version's tag, against BeeWare's
# cpython-android-source-deps (the libraries CPython's script uses; name and
# tarball sum, comma separated). lumtub-media-builds builds it once a day
# and releases it as PYTHON_ANDROID_ARM32_RELEASE (python-arm32.sh --name);
# a recipe not released yet is built in the Android job instead.
PYTHON_ANDROID_SOURCE_COMMIT=b703b2c5e704341d61e367b9b940b77ed11dded0
PYTHON_ANDROID_ARM32_RELEASE=python-android-arm32-3.14.10-05ddc96b27
PYTHON_ANDROID_SHA256_ARM32=5dcf868abbda289cacfcc1d47039bffe02eeb3c048487e62cfaffa5014378245
PYTHON_ANDROID_ARM32_DEPS=bzip2-1.0.8-3:6a337ab443e2639bdcc24e1db867728bfcf15661ee7a5319fe41157249aa79c7,libffi-3.4.4-3:38ab0cab3ec6e94d26ca5fe9e7556130745cce8448c3b5ecf5c48e5238e92f37,openssl-3.5.9-0:fe79dbe5cfb10c1abb2730e2863fd7383ad092324e5d460fb54ee8baf0d91f7d,sqlite-3.53.4-0:958a0928aa334efde0d089b2fe0099aa26aa0a2cb55d63b3c75ad2c16c593602,xz-5.4.6-1:07a5b575dcef750f1decf6cdce1f18aa6e1b6a5080c4ce5ee283b1a40104ba2c,zstd-1.5.7-2:800243ca6ec7e4706b94a892800e9a27cf8894eda35e3088df993e89cd4229cb
# The yt-dlp zip app the APK carries until the app's own update check
# fetches a newer one: a stable release, checked against this sum and
# against that release's SHA2-256SUMS.
YTDLP_VERSION=2026.10.26
YTDLP_SHA256=e51e69e89489f199530f13d32a4342da3ddb2cf34842f364603a066db05afbf3
# The Flutter SDK archives for .flutter-version, by their sums in Flutter's
