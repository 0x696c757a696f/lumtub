# Versions and checksums of the downloads build.yml pins. Plain KEY=value
# lines, read into the job environment by build.yml and kept current by
# .github/scripts/upstream.py (workflow files cannot be pushed by the
# workflow token, so the automation only edits this file).
#
# libmpv for Linux with FFmpeg, libplacebo and their libraries inside it,
# built on Ubuntu 22.04 from mpv master by lumtub-media-builds' GitHub
# Actions (baseline x86_64, x86_64-v3 and aarch64). Pinned by checksum.
MPV_RELEASE=libmpv-20261112-bcde6b93c
MPV_SHA256_X86_64=fc21f7a49ae033f3ce8868d6a9de2023a4599dbfc0b40f2dc1f03c3ad6a72876
MPV_SHA256_X86_64_V3=57cadad64e5e2e6e4757e4c3862d67a3994e163e702121fe24f80c5847fea3a3
MPV_SHA256_AARCH64=f3ec4dfe44d5c751ee0b6e35f646056ba121196d0328546da04480a55848f698
# An LGPL ffmpeg from https://github.com/dfloresc/ffmpeg-macos-builds that
# makes the macOS smoke test's video (the app carries none); sum from its
# SHA256SUMS.
FFMPEG_RELEASE=v9.0.1-1
FFMPEG_ARM64_SHA256=d0ea5ea43a5adfa5d01d4137c9e5a61728b800a812f12917a26fd7af0c14c03a
# appimagetool, by release and the checksum of each build.
APPIMAGETOOL_VERSION=1.9.1
APPIMAGETOOL_SHA256_X86_64=ed4ce84f0d9caff66f50bcca6ff6f35aae54ce8135408b3fa33abfc3cb384eb0
APPIMAGETOOL_SHA256_AARCH64=f0837e7448a0c1e4e650a93bb3e85802546e60654ef287576f46c71c126a9158
