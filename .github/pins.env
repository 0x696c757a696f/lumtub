# 7zr.exe from 7-Zip's GitHub release, for libmpv archives tar.exe cannot open.
SEVENZIP_VERSION=25.01
SEVENZR_SHA256=27cbe3d5804ad09e90bbcaa916da0d5c3b0be9462d0e0fb6cb54be5ed9030875
# The vcpkg commit the Windows on Arm job builds ANGLE with when no
