#!/bin/sh
# Starts Lumtub from the AppImage. Each library under lib/fallback is used
# only when the system has none of that name.
here=$(dirname "$(readlink -f "$0")")
# The x64-v3 package needs AVX2 (and the rest of x86-64-v3).
if [ -e "$here/usr/bin/x86-64-v3" ] && ! grep -qw avx2 /proc/cpuinfo 2>/dev/null; then
  message="This Lumtub package needs a CPU with AVX2. Please download the linux-x64 AppImage instead."
  echo "$message" >&2
  for tool in zenity kdialog notify-send; do
    command -v $tool > /dev/null || continue
    case $tool in
      zenity) zenity --error --title=Lumtub --text="$message" ;;
      kdialog) kdialog --title Lumtub --error "$message" ;;
      notify-send) notify-send Lumtub "$message" ;;
    esac
    break
  done
  exit 1
fi
known=$( (ldconfig -p || /sbin/ldconfig -p) 2>/dev/null)
extra=
for dir in "$here"/usr/bin/lib/fallback/*/; do
  [ -d "$dir" ] || continue
  name=$(basename "$dir")
  case "$known" in
    *"/$name
"* | *"/$name") continue ;;
  esac
  if [ -z "$known" ]; then
    found=
    for system in /usr/lib64 /usr/lib /lib64 /lib /usr/lib/x86_64-linux-gnu /usr/lib/aarch64-linux-gnu; do
      [ -e "$system/$name" ] && found=1 && break
    done
    [ -n "$found" ] && continue
  fi
  extra="$extra${extra:+:}${dir%/}"
done
if [ -n "$extra" ]; then
  LD_LIBRARY_PATH="$extra${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
  export LD_LIBRARY_PATH
fi
exec "$here/usr/bin/lumtub" "$@"
