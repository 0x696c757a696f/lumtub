// Bubble Gel: a built-in Lumtub skin. skins/template/skin.jsonc explains every
// field, and skins/README.md how to make your own.
// 泡泡凝胶：Lumtub 内置皮肤。每个字段的说明见 skins/template/skin.jsonc，自己做皮肤见 skins/README.md。
{
  "$schema": "https://raw.githubusercontent.com/0x696c757a696f/lumtub/main/skins/skin.schema.json",
  "lumtubSkin": 1,
  "id": "aero",
  "name": "Bubble Gel",
  "names": {
    "zh-Hans": "泡泡凝胶",
    "zh-Hant": "泡泡凝膠"
  },
  "description": "Sky-blue glass, glossy gel buttons and floating water bubbles",
  "descriptions": {
    "zh-Hans": "天蓝玻璃、果冻按钮和漂浮的水泡泡",
    "zh-Hant": "天藍玻璃、果凍按鈕和漂浮的水泡泡"
  },
  "brightness": "auto",
  "text": {
    "displayFont": "Baloo 2",
    "monoFont": "Audiowide"
  },
  "colors": {
    "page": "#e6f7ff",
    "text": "#0d2a3d",
    "muted": "#2f4b58",
    "accent": "#0874b0",
    "onAccent": "#ffffff",
    "border": "#a9d7ec",
    "card": "#ffffff",
    "selected": "#cfeeff",
    "onSelected": "#0d2a3d",
    "reason": "#0a6fa6"
  },
  "shape": {
    "cardRadius": 20,
    "controlRadius": 99,
    "thumbnailRadius": 14
  },
  "window": {
    "glass": {
      "min": 0.90
    },
    "background": [
      {
        "image": "day.jpg",
        "fit": "cover"
      }
    ],
    "decorations": [],
    "titleBar": {
      "height": 30,
      "surface": {
        "fill": {
          "linear": {
            "angle": 180,
            "colors": [
              "#ffffff",
              "#e3f5ff",
              "#c9eafa"
            ]
          }
        },
        "border": {
          "color": "#8ccbe8",
          "sides": [
            "bottom"
          ]
        }
      },
      "inactive": {
        "fill": "#eef8fd"
      },
      "text": "#0d2a3d",
      "buttons": {
        "size": [
          36,
          24
        ],
        "icon": "#0d4f73",
        "surface": {
          "fill": "transparent",
          "radius": 13,
          "hover": {
            "fill": {
              "linear": {
                "angle": 180,
                "colors": [
                  "#ffffff",
                  "#b8e6fb"
                ]
              }
            },
            "gloss": 0.6
          },
          "pressed": {
            "fill": "#9fd8f2"
          }
        },
        "close": {
          "fill": "transparent",
          "radius": 13,
          "hover": {
            "fill": {
              "linear": {
                "angle": 180,
                "colors": [
                  "#ff9b9b",
                  "#d4262e"
                ]
              }
            },
            "gloss": 0.6
          },
          "pressed": {
            "fill": "#a81b22"
          }
        }
      }
    },
    "topBar": {
      "fill": {
        "linear": {
          "angle": 180,
          "colors": [
            "#ffffffe6",
            "#e8f7ffcc"
          ]
        }
      },
      "border": {
        "color": "#9fcfe6",
        "sides": [
          "bottom"
        ]
      },
      "shadow": [
        {
          "color": "#1e78aa1f",
          "y": 2,
          "blur": 10
        }
      ]
    },
    "sideBar": {
      "fill": "#ffffff73",
      "border": {
        "color": "#ffffffe6",
        "sides": [
          "right"
        ]
      }
    },
    "statusBar": {
      "fill": {
        "linear": {
          "angle": 180,
          "colors": [
            "#ffffffd9",
            "#d4eefad9"
          ]
        }
      },
      "border": {
        "color": "#9fcfe6",
        "sides": [
          "top"
        ]
      }
    },
    "statusBarText": "#0d2a3d",
    "veil": 0.7
  },
  "controls": {
    "button": {
      "fill": {
        "linear": {
          "angle": 180,
          "colors": [
            "#fffffff2",
            "#dcf2fce6"
          ]
        }
      },
      "border": "#a6d6ec",
      "hover": {
        "fill": "#ffffff"
      }
    },
    "buttonText": "#0d2a3d",
