        }
      }
    },
    "padding": 8,
    "panel": {
      "fill": "#ffffffcc",
      "border": "#ffffff"
    },
    "durationBadge": {
      "fill": "#0d2a3dcc",
      "border": "#ffffff80"
    },
    "durationText": "#ffffff"
  },
  "logo": {
    "text": "Lumtub",
    "font": "Baloo 2",
    "size": 26,
    "fill": {
      "linear": {
        "angle": 180,
        "colors": [
          "#43b8ee",
          "#0868a8"
        ]
      }
    },
    "shadow": "#ffffff",
    "badge": {
      "fill": {
        "radial": {
          "center": [
            0.5,
            0.75
          ],
          "radius": 0.7,
          "colors": [
            "#a8ff7a",
            "#13782c"
          ]
        }
      },
      "gloss": 0.8,
      "border": "#ffffff"
    },
    "badgeIcon": "#ffffff"
  },
  "player": {
    // A silver capsule with a blue glass screen and a big glossy play ball.
    // 银色胶囊机身，蓝色玻璃屏，中间一个大的圆形播放球。
    "style": "deck",
    "deck": {
      "shape": "capsule",
      "body": ["#fbfcfd", "#dfe5ec", "#b9c3cf", "#d6dde5"],
      "rim": "#7b8796",
      "screen": "#0a3a6a",
      "screenText": "#a8ecff",
      "button": ["#d6f2ff", "#256cb8"],
      "glyph": "#ffffff",
      "play": ["#e2fbff", "#106ead"],
      "playGlyph": "#ffffff",
      "groove": "#7d8a99",
      "fill": "#2fb4ff"
    },
    "progress": {
      "linear": {
        "angle": 90,
        "colors": [
          "#19b8ff",
          "#5fe0ff",
          "#8df27a"
        ]
      }
    }
  },
