      "border": "#a6d6ec"
    },
    "chipSelected": {
      "fill": {
        "linear": {
          "angle": 180,
          "colors": [
            "#278222",
            "#1a6418"
          ]
        }
      },
      "gloss": 0.7,
      "border": "#155a14"
    },
    "chipSelectedText": "#ffffff",
    "navSelected": {
      "fill": {
        "linear": {
          "angle": 180,
          "colors": [
            "#fffffff2",
            "#d6f0fd"
          ]
        }
      },
      "gloss": 0.5,
      "border": "#ffffff",
      "shadow": [
        {
          "color": "#1e8cc84d",
          "y": 2,
          "blur": 10
        }
      ]
    },
    "navSelectedText": "#075f91",
    "navText": "#0d2a3d"
  },
  "icons": {
    "style": "fill",
    "effect": "gel"
  },
  "cards": {
    "video": {
      "fill": "#ffffff99",
      "border": "#fffffff2",
      "shadow": [
        {
          "color": "#1e78aa26",
          "y": 6,
          "blur": 16
