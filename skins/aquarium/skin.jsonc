// Millennium Aquarium: a built-in Lumtub skin. skins/template/skin.jsonc explains every
// field, and skins/README.md how to make your own.
// 千禧水族箱：Lumtub 内置皮肤。每个字段的说明见 skins/template/skin.jsonc，自己做皮肤见 skins/README.md。
{
  "$schema": "https://raw.githubusercontent.com/0x696c757a696f/lumtub/main/skins/skin.schema.json",
  "lumtubSkin": 1,
  "id": "aquarium",
  "name": "Millennium Aquarium",
  "names": {
    "zh-Hans": "千禧水族箱",
    "zh-Hant": "千禧水族箱"
  },
  "description": "A collage of the 2000s: shining discs, a crystal ball with a city and fish, glass stars, gel balls and a silver boombox player",
  "descriptions": {
    "zh-Hans": "千禧年代的拼贴：彩虹光碟、装着城市和金鱼的水晶球、玻璃星星、绿玻璃球和银色手提音箱播放器",
    "zh-Hant": "千禧年代的拼貼：彩虹光碟、裝著城市和金魚的水晶球、玻璃星星、綠玻璃球和銀色手提音箱播放器"
  },
  "brightness": "auto",
  "text": {
    "displayFont": "Baloo 2",
    "monoFont": "Audiowide"
  },
