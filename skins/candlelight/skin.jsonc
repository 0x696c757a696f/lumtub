// Candlelight: one of Lumtub's colour schemes as a skin. It follows the theme
// mode: "colors" are the light side, "overrides.dark" the dark one.
// 烛光：Lumtub 的配色方案之一。跟随浅色/深色模式："colors" 是浅色，"overrides.dark" 是深色。
{
  "$schema": "https://raw.githubusercontent.com/0x696c757a696f/lumtub/main/skins/skin.schema.json",
  "lumtubSkin": 1,
  "id": "candlelight",
  "name": "Candlelight",
  "names": {
    "zh-Hans": "烛光",
    "zh-Hant": "燭光"
  },
  "description": "For evenings: little blue, a touch of amber everywhere",
  "descriptions": {
    "zh-Hans": "晚上用，少蓝光，处处带一点琥珀光",
    "zh-Hant": "適合晚上使用，藍光較少，處處帶一點琥珀光"
  },
  "author": "Lumtub",
  "version": "1.0",
  "license": "CC0-1.0",
  "brightness": "auto",
  "colors": {
    "page": "#f8ecd6",
    "text": "#33230f",
    "accent": "#8f4c0e",
    "selected": "#f0d9ae",
    "tint": 0.1
  },
  "overrides": {
    "dark": {
      "colors": {
        "page": "#1b130a",
        "text": "#f0dcbc",
        "accent": "#e6a04a",
        "selected": "#3a2711",
        "tint": 0.1
      }
    }
  }
}
