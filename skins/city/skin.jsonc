        ],
        "icon": "#0d4f73",
        "surface": {
          "fill": "transparent",
          "radius": 13,
          "hover": {
            "fill": {
              "linear": {
                "angle": 180,
                "colors": [
                  "#ffffff",
                  "#b8e6fb"
                ]
              }
            },
            "gloss": 0.6
          },
          "pressed": {
            "fill": "#9fd8f2"
          }
        },
        "close": {
          "fill": "transparent",
          "radius": 13,
          "hover": {
            "fill": {
              "linear": {
                "angle": 180,
                "colors": [
