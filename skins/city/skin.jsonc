// Green Tomorrow: a built-in Lumtub skin. skins/template/skin.jsonc explains every
// field, and skins/README.md how to make your own.
// 绿色未来城：Lumtub 内置皮肤。每个字段的说明见 skins/template/skin.jsonc，自己做皮肤见 skins/README.md。
{
  "$schema": "https://raw.githubusercontent.com/0x696c757a696f/lumtub/main/skins/skin.schema.json",
  "lumtubSkin": 1,
  "id": "city",
  "name": "Green Tomorrow",
  "names": {
    "zh-Hans": "绿色未来城",
    "zh-Hant": "綠色未來城"
  },
  "description": "Glass towers with gardens on their terraces, white wind turbines and a quiet train over green hills: a hopeful tomorrow where nature and machines get along",
  "descriptions": {
    "zh-Hans": "露台上长着花园的玻璃高楼、白色风车、安静驶过绿色山坡的列车：自然和机器和谐相处的明天",
    "zh-Hant": "露台上長著花園的玻璃高樓、白色風車、安靜駛過綠色山坡的列車：自然和機器和諧相處的明天"
  },
  "brightness": "auto",
  "text": {
    "displayFont": "Baloo 2",
    "monoFont": "Audiowide"
  },
  "colors": {
    "page": "#eefbe9",
    "text": "#08140b",
    "muted": "#384c3c",
    "accent": "#2a7d1f",
