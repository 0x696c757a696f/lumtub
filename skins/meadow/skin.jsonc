// Sunny Meadow: a built-in Lumtub skin. skins/template/skin.jsonc explains every
// field, and skins/README.md how to make your own.
// 晴空草原：Lumtub 内置皮肤。每个字段的说明见 skins/template/skin.jsonc，自己做皮肤见 skins/README.md。
{
  "$schema": "https://raw.githubusercontent.com/0x696c757a696f/lumtub/main/skins/skin.schema.json",
  "lumtubSkin": 1,
  "id": "meadow",
  "name": "Sunny Meadow",
  "names": {
    "zh-Hans": "晴空草原",
    "zh-Hant": "晴空草原"
  },
  "description": "Blue sky over rolling green grass, lens glints and soft light",
  "descriptions": {
    "zh-Hans": "蓝天下起伏的绿草地、镜头光点和柔和阳光",
    "zh-Hant": "藍天下起伏的綠草地、鏡頭光點和柔和陽光"
  },
  "brightness": "light",
  "text": {
    "displayFont": "Baloo 2",
    "monoFont": "Audiowide"
  },
  "colors": {
    "page": "#eefbe9",
    "text": "#14301a",
    "muted": "#4a6650",
    "accent": "#2a7d1f",
    "onAccent": "#ffffff",
    "border": "#b5dfa8",
    "card": "#ffffff",
    "selected": "#d6f3cb",
    "onSelected": "#14301a",
    "reason": "#2a7d1f"
  },
  "shape": {
    "cardRadius": 20,
    "controlRadius": 99,
    "thumbnailRadius": 14
  },
  "window": {
    "background": [
      {
        "linear": {
          "angle": 180,
          "colors": [
            "#6cc6ff",
            "#bfe8ff",
            "#f4fff0",
            "#bff0a6",
            "#7fd65e"
          ]
        }
      },
      {
        "radial": {
          "center": [
            0.8,
            0.05
          ],
          "radius": 0.4,
          "colors": [
            "#fffff0ff",
            "#fffff000"
          ]
        }
      },
      {
        "radial": {
          "center": [
            0.3,
            1.3
          ],
          "radius": 0.75,
          "colors": [
            "#4fbf3acc",
            "#4fbf3a00"
          ]
        }
      }
    ],
    "decorations": [
      {
        "type": "waves",
        "count": 2,
        "color": "#7fe06a59",
        "seed": 9,
        "position": 0.88
      },
      {
        "type": "sparkles",
        "count": 5,
        "color": "#ffffff",
        "glow": "#fff7a8",
        "seed": 6
      }
    ],
    "titleBar": {
      "height": 30,
      "surface": {
        "fill": {
          "linear": {
            "angle": 180,
            "colors": [
              "#ffffff",
              "#e3f5ff",
              "#c9eafa"
            ]
          }
        },
        "border": {
          "color": "#8ccbe8",
          "sides": [
            "bottom"
          ]
        }
      },
      "inactive": {
        "fill": "#eef8fd"
      },
      "text": "#0d2a3d",
      "buttons": {
        "size": [
          36,
          24
        ],
        "icon": "#0d4f73",
        "surface": {
          "fill": "transparent",
          "radius": 13,
          "hover": {
            "fill": {
              "linear": {
                "angle": 180,
                "colors": [
                  "#ffffff",
                  "#b8e6fb"
                ]
              }
            },
            "gloss": 0.6
          },
          "pressed": {
            "fill": "#9fd8f2"
          }
        },
        "close": {
          "fill": "transparent",
          "radius": 13,
          "hover": {
            "fill": {
              "linear": {
                "angle": 180,
                "colors": [
                  "#ff9b9b",
                  "#d4262e"
                ]
              }
            },
            "gloss": 0.6
          },
          "pressed": {
            "fill": "#a81b22"
          }
        }
      }
    },
    "topBar": {
      "fill": {
        "linear": {
          "angle": 180,
          "colors": [
            "#ffffffe6",
            "#e8f7ffcc"
          ]
        }
      },
      "border": {
        "color": "#9fcfe6",
        "sides": [
          "bottom"
        ]
      },
      "shadow": [
        {
          "color": "#1e78aa1f",
          "y": 2,
          "blur": 10
        }
      ]
    },
    "sideBar": {
      "fill": "#ffffff73",
      "border": {
        "color": "#ffffffe6",
        "sides": [
          "right"
        ]
      }
    },
    "statusBar": {
      "fill": {
        "linear": {
          "angle": 180,
          "colors": [
            "#ffffffd9",
            "#d4eefad9"
          ]
        }
      },
      "border": {
        "color": "#9fcfe6",
        "sides": [
          "top"
        ]
      }
    }
  },
  "controls": {
    "button": {
      "fill": {
        "linear": {
          "angle": 180,
          "colors": [
            "#fffffff2",
            "#dcf2fce6"
          ]
        }
      },
      "border": "#a6d6ec",
      "hover": {
        "fill": "#ffffff"
      }
    },
    "buttonText": "#0d2a3d",
    "primaryButton": {
      "fill": {
        "linear": {
          "angle": 180,
          "colors": [
            "#2c7f21",
            "#175411"
          ]
        }
      },
      "gloss": 0.7,
      "border": "#195a12",
      "hover": {
        "fill": {
          "linear": {
            "angle": 180,
            "colors": [
              "#338c27",
              "#1a5f14"
            ]
          }
        }
      }
    },
    "primaryButtonText": "#ffffff",
    "chip": {
      "fill": {
        "linear": {
          "angle": 180,
          "colors": [
            "#fffffff2",
            "#e0f3fce6"
          ]
        }
      },
      "border": "#a6d6ec"
    },
    "chipSelected": {
      "fill": {
        "linear": {
          "angle": 180,
          "colors": [
            "#0f6aa6",
            "#084a7a"
          ]
        }
      },
      "gloss": 0.7,
      "border": "#0a5287"
    },
    "chipSelectedText": "#ffffff",
    "navSelected": {
      "fill": {
        "linear": {
          "angle": 180,
          "colors": [
            "#fffffff2",
            "#d6f0fd"
          ]
        }
      },
      "gloss": 0.5,
      "border": "#ffffff",
      "shadow": [
        {
          "color": "#1e8cc84d",
          "y": 2,
          "blur": 10
        }
      ]
    },
    "navSelectedText": "#1f6b16",
    "navText": "#2e4a33"
  },
  "icons": {
    "style": "fill",
    "effect": "gel"
  },
  "cards": {
    "video": {
      "fill": "#ffffff99",
      "border": "#fffffff2",
      "shadow": [
        {
          "color": "#1e78aa26",
          "y": 6,
          "blur": 16
        }
      ],
      "hover": {
        "border": {
          "color": "#7fd65e",
          "width": 2
        }
      },
      "focused": {
        "border": {
          "color": "#2a7d1f",
          "width": 3
        }
      }
    },
    "padding": 8,
    "panel": {
      "fill": "#ffffffcc",
      "border": "#ffffff"
    },
    "durationBadge": {
      "fill": "#0d2a3dcc",
      "border": "#ffffff80"
    },
    "durationText": "#ffffff"
  },
  "logo": {
    "text": "Lumtub",
    "font": "Baloo 2",
    "size": 26,
    "fill": {
      "linear": {
        "angle": 180,
        "colors": [
          "#4fbf3a",
          "#1f6b16"
        ]
      }
    },
    "shadow": "#ffffff",
    "badge": {
      "fill": {
        "radial": {
          "center": [
            0.5,
            0.75
          ],
          "radius": 0.7,
          "colors": [
            "#bff3ff",
            "#1272b8"
          ]
        }
      },
      "gloss": 0.8,
      "border": "#ffffff"
    },
    "badgeIcon": "#ffffff"
  },
  "player": {
    "progress": {
      "linear": {
        "angle": 90,
        "colors": [
          "#38a8ff",
          "#7fe06a",
          "#d6ff8a"
        ]
      }
    }
  },
  "author": "Lumtub",
  "license": "CC0-1.0"
}
