// Brushed Metal: a built-in Lumtub skin. skins/template/skin.jsonc explains every
// field, and skins/README.md how to make your own.
// 金属拟物：Lumtub 内置皮肤。每个字段的说明见 skins/template/skin.jsonc，自己做皮肤见 skins/README.md。
{
  "$schema": "https://raw.githubusercontent.com/0x696c757a696f/lumtub/main/skins/skin.schema.json",
  "lumtubSkin": 1,
  "id": "metal",
  "name": "Brushed Metal",
  "names": {
    "zh-Hans": "金属拟物",
    "zh-Hant": "金屬擬物"
  },
  "description": "Brushed steel, glossy raised buttons and an orange glow on what is chosen, as the first touch phones had",
  "descriptions": {
    "zh-Hans": "拉丝钢板、凸起的高光按钮，选中时亮起橙光，像最早的触屏手机",
    "zh-Hant": "拉絲鋼板、凸起的高光按鈕，選中時亮起橙光，像最早的觸屏手機"
  },
  "brightness": "light",
  "colors": {
    "page": "#d9dbde",
    "text": "#16181b",
    "muted": "#474c53",
    "accent": "#b35400",
    "onAccent": "#ffffff",
    "border": "#9aa0a8",
    "card": "#eef0f2",
    "selected": "#ffd9a8",
    "onSelected": "#2a1500",
    "reason": "#8a4300"
  },
  "shape": {
    "cardRadius": 6,
    "controlRadius": 6,
    "thumbnailRadius": 3
  },
  "window": {
    "background": [
      {
        "linear": {
          "angle": 180,
          "colors": [
            "#e6e8eb",
            "#c9ccd1"
          ]
        }
      },
      {
        "pattern": {
          "type": "lines",
          "color": "#ffffff26",
          "spacing": 2,
          "size": 1
        }
      },
      {
        "pattern": {
          "type": "lines",
          "color": "#0000000d",
          "spacing": 5,
          "size": 1
        }
      }
    ],
    "titleBar": {
      "height": 28,
      "surface": {
        "fill": [
          {
            "linear": {
              "angle": 180,
              "colors": [
                "#5c6168",
                "#2f3338",
                "#1f2226"
              ],
              "stops": [
                0,
                0.5,
                1
              ]
            }
          },
          {
            "pattern": {
              "type": "lines",
              "color": "#ffffff0d",
              "spacing": 2,
              "size": 1
            }
          }
        ],
        "border": {
          "color": "#0e0f11",
          "sides": [
            "bottom"
          ]
        }
      },
      "inactive": {
        "fill": {
          "linear": {
            "angle": 180,
            "colors": [
              "#6d7178",
              "#45494f"
            ]
          }
        }
      },
      "text": "#f2f3f5",
      "inactiveText": "#dcdee1",
      "buttons": {
        "size": [
          34,
          22
        ],
        "icon": "#e9ebee",
        "surface": {
          "fill": "transparent",
          "radius": 4,
          "hover": {
            "fill": {
              "linear": {
                "angle": 180,
                "colors": [
                  "#7b8189",
                  "#4a4f56"
                ]
              }
            },
            "gloss": 0.5
          },
          "pressed": {
            "fill": {
              "linear": {
                "angle": 180,
                "colors": [
                  "#ffb54a",
                  "#d96a00"
                ]
              }
            }
          }
        },
        "close": {
          "fill": "transparent",
          "radius": 4,
          "hover": {
            "fill": {
              "linear": {
                "angle": 180,
                "colors": [
                  "#ff8a6a",
                  "#c8321c"
                ]
              }
            },
            "gloss": 0.5
          },
          "pressed": {
            "fill": "#9c2210"
          }
        }
      }
    },
    "menuBar": {
      "surface": {
        "fill": {
          "linear": {
            "angle": 180,
            "colors": [
              "#3a3e44",
              "#2a2d32"
            ]
          }
        },
        "border": {
          "color": "#0e0f11",
          "sides": [
            "bottom"
          ]
        }
      },
      "text": "#eceef1",
      "highlight": {
        "fill": {
          "linear": {
            "angle": 180,
            "colors": [
              "#ffb54a",
              "#d96a00"
            ]
          }
        }
      },
      "highlightText": "#1a0d00",
      "menu": {
        "fill": "#2b2e33f5",
        "border": "#5a5f66",
        "radius": 4
      }
    },
    "topBar": {
      "fill": [
        {
          "linear": {
            "angle": 180,
            "colors": [
              "#f4f5f7",
              "#c3c7cc"
            ]
          }
        },
        {
          "pattern": {
            "type": "lines",
            "color": "#ffffff33",
            "spacing": 2,
            "size": 1
          }
        }
      ],
      "border": {
        "color": "#7c828a",
        "sides": [
          "bottom"
        ]
      },
      "shadow": [
        {
          "color": "#00000040",
          "y": 2,
          "blur": 6
        }
      ]
    },
    "sideBar": {
      "fill": [
        {
          "linear": {
            "angle": 90,
            "colors": [
              "#2f3338",
              "#1d2024"
            ]
          }
        }
      ],
      "border": {
        "color": "#0e0f11",
        "sides": [
          "right"
        ]
      }
    },
    "statusBar": {
      "fill": {
        "linear": {
          "angle": 180,
          "colors": [
            "#3a3e44",
            "#26292d"
          ]
        }
      },
      "border": {
        "color": "#0e0f11",
        "sides": [
          "top"
        ]
      }
    },
    "topBarText": "#16181b",
    "statusBarText": "#d8dbdf"
  },
  "controls": {
    "press": "glow",
    "button": {
      "fill": {
        "linear": {
          "angle": 180,
          "colors": [
            "#ffffff",
            "#d4d7db",
            "#bfc3c8"
          ],
          "stops": [
            0,
            0.5,
            1
          ]
        }
      },
      "gloss": 0.55,
      "border": "#7c828a",
      "radius": 6,
      "hover": {
        "fill": {
          "linear": {
            "angle": 180,
            "colors": [
              "#ffffff",
              "#e1e4e7"
            ]
          }
        }
      },
      "pressed": {
        "fill": {
          "linear": {
            "angle": 180,
            "colors": [
              "#b9bdc2",
              "#dfe2e5"
            ]
          }
        }
      }
    },
    "buttonText": "#16181b",
    "primaryButton": {
      "fill": {
        "linear": {
          "angle": 180,
          "colors": [
            "#a85200",
            "#7a3800"
          ]
        }
      },
      "gloss": 0.6,
      "border": "#6b3100",
      "radius": 6,
      "hover": {
        "fill": {
          "linear": {
            "angle": 180,
            "colors": [
              "#d26b00",
              "#9a4700"
            ]
          }
        }
      },
      "pressed": {
        "fill": {
          "linear": {
            "angle": 180,
            "colors": [
              "#8a3f00",
              "#b35a00"
            ]
          }
        }
      }
    },
    "primaryButtonText": "#ffffff",
    "chip": {
      "fill": {
        "linear": {
          "angle": 180,
          "colors": [
            "#fbfbfc",
            "#d2d5d9"
          ]
        }
      },
      "border": "#8d939b",
      "radius": 6
    },
    "chipSelected": {
      "fill": {
        "linear": {
          "angle": 180,
          "colors": [
            "#a85200",
            "#7a3800"
          ]
        }
      },
      "gloss": 0.6,
      "border": "#6b3100",
      "radius": 6
    },
    "chipSelectedText": "#ffffff",
    "navSelected": {
      "fill": {
        "linear": {
          "angle": 180,
          "colors": [
            "#ffb54a",
            "#d96a00"
          ]
        }
      },
      "gloss": 0.55,
      "border": "#ffcf8a",
      "radius": 6,
      "glow": "#ff9a1f"
    },
    "navSelectedText": "#1a0d00",
    "navText": "#d2d5d9"
  },
  "cards": {
    "video": {
      "fill": {
        "linear": {
          "angle": 180,
          "colors": [
            "#f7f8f9",
            "#e3e6e9"
          ]
        }
      },
      "border": "#a4aab2",
      "shadow": [
        {
          "color": "#0000002e",
          "y": 3,
          "blur": 6
        }
      ],
      "hover": {
        "border": {
          "color": "#d96a00",
          "width": 2
        }
      },
      "focused": {
        "border": {
          "color": "#ff9a1f",
          "width": 3
        }
      }
    },
    "padding": 6,
    "panel": {
      "fill": "#eef0f2f2",
      "border": "#9aa0a8"
    },
    "durationBadge": {
      "fill": "#16181bd9",
      "radius": 3
    },
    "durationText": "#ffffff"
  },
  "logo": {
    "text": "Lumtub",
    "size": 24,
    "fill": {
      "linear": {
        "angle": 180,
        "colors": [
          "#4a4f56",
          "#16181b"
        ]
      }
    },
    "shadow": "#ffffff",
    "badge": {
      "fill": {
        "radial": {
          "center": [
            0.5,
            0.75
          ],
          "radius": 0.7,
          "colors": [
            "#ffd08a",
            "#c25a00"
          ]
        }
      },
      "gloss": 0.8,
      "border": "#6b3100"
    },
    "badgeIcon": "#ffffff"
  },
  "icons": {
    "style": "fill",
    "effect": "emboss"
  },
  "player": {
    "progress": {
      "linear": {
        "angle": 90,
        "colors": [
          "#ffb54a",
          "#d96a00"
        ]
      }
    }
  },
  "author": "Lumtub",
  "license": "CC0-1.0"
}
