      "playGlyph": "#ffffff",
      "groove": "#0e6a84",
      "fill": "#7ff0ff"
    },
    "progress": {
      "linear": {
        "angle": 90,
        "colors": [
          "#16b5c9",
          "#4fe0d9",
          "#a6f5ff"
        ]
      }
    }
  },
