                "blur": 5
              }
            ]
          },
          "text": "#f1f1f3",
          "selectedText": "#0f0f0f",
          "indicator": "#b40f47"
        },
        "background": [
          "#1e1e1e"
        ],
        "titleBar": {
          "height": 26,
          "surface": {
            "fill": "#6975cb"
          },
          "inactive": {
            "fill": "#616bb6"
          },
          "text": "#0f0f0f",
          "inactiveText": "#181c3c",
          "buttons": {
            "size": [
              40,
              26
            ],
            "icon": "#ffffff",
            "surface": {
              "fill": "transparent",
              "hover": {
                "fill": "#ffffff26"
              },
              "pressed": {
                "fill": "#ffffff40"
              }
            },
            "close": {
              "fill": "transparent",
              "hover": {
                "fill": "#e53935"
              },
              "pressed": {
                "fill": "#b71c1c"
              }
            }
          }
        },
        "menuBar": {
          "surface": {
            "fill": "#5664bb"
          },
          "text": "#f1f1f1",
          "highlight": {
            "fill": "#1a237e"
          },
          "highlightText": "#ffffff",
          "menu": {
            "fill": "#0f0f0f",
            "border": "#2a2a2a",
            "radius": 2,
            "shadow": [
              {
                "color": "#00000040",
                "y": 4,
                "blur": 10
              }
            ]
          },
          "underlineKeys": true
        },
        "topBar": {
          "fill": "#5664bb",
          "shadow": [
            {
              "color": "#00000047",
              "y": 2,
              "blur": 5
            }
          ]
        },
        "sideBar": {
          "fill": "#141414",
          "border": {
            "color": "#2a2a2a",
            "sides": [
              "right"
            ]
          }
        },
        "statusBar": {
          "fill": "#141414",
          "border": {
            "color": "#2a2a2a",
            "sides": [
              "top"
            ]
          }
        },
        "topBarText": "#0f0f0f",
        "statusBarText": "#999999"
      },
      "controls": {
        "press": "ripple",
        "button": {
          "fill": "#0f0f0f",
          "radius": 2,
          "shadow": [
            {
              "color": "#00000033",
              "y": 1,
              "blur": 3
            }
          ],
          "hover": {
            "fill": "#181818"
          }
        },
        "buttonText": "#6975cb",
        "primaryButton": {
          "fill": "#c2185b",
          "radius": 2,
          "shadow": [
            {
              "color": "#00000040",
              "y": 2,
              "blur": 4
            }
          ],
          "hover": {
            "fill": "#ad1457"
          }
        },
        "primaryButtonText": "#ffffff",
        "chip": {
          "fill": "#2a2a2a",
          "radius": 16
        },
        "chipSelected": {
          "fill": "#3949ab",
          "radius": 16
        },
        "chipSelectedText": "#ffffff",
        "navSelected": {
          "fill": "#e8eaf6",
          "radius": 2
        },
        "navSelectedText": "#283593",
        "navText": "#999999"
      },
      "cards": {
        "video": {
          "fill": "#0f0f0f",
          "radius": 2,
          "shadow": [
            {
              "color": "#00000029",
              "y": 1,
              "blur": 3
            },
            {
              "color": "#0000001f",
              "y": 1,
              "blur": 2
            }
          ],
          "hover": {
            "shadow": [
              {
                "color": "#00000038",
                "y": 6,
                "blur": 12
              }
            ]
          },
          "focused": {
            "border": {
              "color": "#5664bb",
              "width": 3
            }
          }
        },
        "padding": 0,
        "panel": {
          "fill": "#0f0f0f",
          "shadow": [
            {
              "color": "#00000029",
              "y": 1,
              "blur": 3
            }
          ]
        },
        "durationBadge": {
          "fill": "#000000b3",
          "radius": 2
        },
        "durationText": "#ffffff"
      },
