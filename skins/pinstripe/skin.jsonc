// Pinstripe Gel: a built-in Lumtub skin. skins/template/skin.jsonc explains
// every field, and skins/README.md how to make your own.
// 细条纹凝胶：Lumtub 内置皮肤。每个字段的说明见 skins/template/skin.jsonc，自己做皮肤见 skins/README.md。
{
  "$schema": "https://raw.githubusercontent.com/0x696c757a696f/lumtub/main/skins/skin.schema.json",
  "lumtubSkin": 1,
  "id": "pinstripe",
  "name": "Pinstripe Gel",
  "names": {
    "zh-Hans": "细条纹凝胶",
    "zh-Hant": "細條紋凝膠"
  },
  "description": "Fine grey pinstripes, glossy blue gel buttons and soft drop shadows, as desktops looked around 2001",
  "descriptions": {
    "zh-Hans": "细灰条纹、亮蓝凝胶按钮和柔和投影，像 2001 年前后的桌面",
    "zh-Hant": "細灰條紋、亮藍凝膠按鈕和柔和投影，像 2001 年前後的桌面"
  },
  "brightness": "light",
  "colors": {
    "page": "#f2f2f2",
    "text": "#1a1a1a",
    "muted": "#555b63",
    "accent": "#1660c4",
    "onAccent": "#ffffff",
    "border": "#b9bec6",
    "card": "#ffffff",
    "selected": "#cfe0f7",
    "onSelected": "#0f2a52",
    "reason": "#1660c4"
  },
  "shape": {
    "cardRadius": 8,
    "controlRadius": 99,
    "thumbnailRadius": 4
  },
  "window": {
    "background": [
      "#f3f3f3",
      {
        "pattern": {
          "type": "lines",
          "color": "#0000000c",
          "spacing": 4,
          "size": 2
        }
      }
    ],
    "titleBar": {
      "height": 26,
      "surface": {
        "fill": [
          {
            "linear": {
              "angle": 180,
              "colors": [
                "#fafafa",
                "#dcdcdc"
              ]
            }
          },
          {
            "pattern": {
              "type": "lines",
              "color": "#00000012",
              "spacing": 2,
              "size": 1
            }
          }
        ],
        "border": {
          "color": "#9a9a9a",
          "sides": [
            "bottom"
          ]
        }
      },
      "inactive": {
        "fill": "#ececec"
      },
      "text": "#1a1a1a",
      "inactiveText": "#6b6b6b",
      "align": "center",
      "icon": false,
      // Round gel buttons at the left: close, minimise, maximise. Their
      // signs show under the pointer.
      // 左边的圆形凝胶按钮：关闭、最小化、最大化；鼠标移上去才显示符号。
      "buttons": {
        "placement": "left",
        "glyphs": "hover",
        "size": [
          15,
          15
        ],
        "icon": "#3b2a12",
        "surface": {
          "fill": {
            "radial": {
              "center": [
                0.5,
                0.8
              ],
              "radius": 0.7,
              "colors": [
                "#c9f2a8",
                "#4ea83a"
              ]
            }
          },
          "radius": 99,
          "gloss": 0.75,
          "border": "#2f7a22",
          "hover": {
            "fill": {
              "radial": {
                "center": [
                  0.5,
                  0.8
                ],
                "radius": 0.7,
                "colors": [
                  "#d8f8bd",
                  "#5cb948"
                ]
              }
            },
            "gloss": 0.75
          },
          "pressed": {
            "fill": "#3b8a2c"
          }
        },
        "minimize": {
          "fill": {
            "radial": {
              "center": [
                0.5,
                0.8
              ],
              "radius": 0.7,
              "colors": [
                "#ffe9a6",
                "#e0a225"
              ]
            }
          },
          "radius": 99,
          "gloss": 0.75,
          "border": "#a8740f",
          "hover": {
            "fill": {
              "radial": {
                "center": [
                  0.5,
                  0.8
                ],
                "radius": 0.7,
                "colors": [
                  "#fff0bf",
                  "#eab03a"
                ]
              }
            },
            "gloss": 0.75
          },
          "pressed": {
            "fill": "#c08718"
          }
        },
        "close": {
          "fill": {
            "radial": {
              "center": [
                0.5,
                0.8
              ],
              "radius": 0.7,
              "colors": [
                "#ffb3aa",
                "#d9473b"
              ]
            }
          },
          "radius": 99,
          "gloss": 0.75,
          "border": "#a52b22",
          "hover": {
            "fill": {
              "radial": {
                "center": [
                  0.5,
                  0.8
                ],
                "radius": 0.7,
                "colors": [
                  "#ffc4bc",
                  "#e45a4e"
                ]
              }
            },
            "gloss": 0.75
          },
          "pressed": {
            "fill": "#b8332a"
          }
        }
      }
    },
    // Menus along the very top, above the title bar, with the app's own
    // menu first in bold, as desktops of the time had them.
    // 菜单在最顶上、标题栏之上，第一个是粗体的应用菜单，像当年的桌面。
    "menuBar": {
      "position": "top",
      "appMenu": true,
      "underlineKeys": false,
      "height": 24,
      "surface": {
        "fill": {
          "linear": {
            "angle": 180,
            "colors": [
              "#ffffff",
              "#e9e9e9"
            ]
          }
        },
        "border": {
          "color": "#b3b3b3",
          "sides": [
            "bottom"
          ]
        }
      },
      "text": "#1a1a1a",
      "highlight": {
        "fill": {
          "linear": {
            "angle": 180,
            "colors": [
              "#2a74d0",
              "#0f4fa8"
            ]
          }
        }
      },
      "highlightText": "#ffffff",
      "menu": {
        "fill": "#fbfbfbf2",
        "border": "#a8a8a8",
        "radius": 6,
        "shadow": [
          {
            "color": "#00000040",
            "y": 6,
            "blur": 16
          }
        ]
      },
      "clock": true
    },
    "topBar": {
      "fill": [
        {
          "linear": {
            "angle": 180,
            "colors": [
              "#f7f7f7",
              "#e2e2e2"
            ]
          }
        },
        {
          "pattern": {
            "type": "lines",
            "color": "#0000000c",
            "spacing": 2,
            "size": 1
          }
        }
      ],
      "border": {
        "color": "#a3a3a3",
        "sides": [
          "bottom"
        ]
      }
    },
    "sideBar": {
      "fill": "#e9edf2e6",
      "border": {
        "color": "#c3c7cd",
        "sides": [
          "right"
        ]
      }
    },
    "statusBar": {
      "fill": {
        "linear": {
          "angle": 180,
          "colors": [
            "#ececec",
            "#d9d9d9"
          ]
        }
      },
      "border": {
        "color": "#a3a3a3",
        "sides": [
          "top"
        ]
      }
    }
  },
  "controls": {
    "button": {
      "fill": {
        "linear": {
          "angle": 180,
          "colors": [
            "#ffffff",
            "#dedede"
          ]
        }
      },
      "gloss": 0.5,
      "border": "#9c9c9c",
      "hover": {
        "fill": "#ffffff"
      }
    },
    "buttonText": "#1a1a1a",
    "primaryButton": {
      "fill": {
        "linear": {
          "angle": 180,
          "colors": [
            "#1f68c4",
            "#0b3f8c"
          ]
        }
      },
      "gloss": 0.8,
      "border": "#0c3f87",
      "hover": {
        "fill": {
          "linear": {
            "angle": 180,
            "colors": [
              "#2672cc",
              "#0e4799"
            ]
          }
        }
      }
    },
    "primaryButtonText": "#ffffff",
    "chip": {
      "fill": {
        "linear": {
          "angle": 180,
          "colors": [
            "#ffffff",
            "#e4e4e4"
          ]
        }
      },
      "border": "#a9a9a9"
    },
    "chipSelected": {
      "fill": {
        "linear": {
          "angle": 180,
          "colors": [
            "#1f68c4",
            "#0b3f8c"
          ]
        }
      },
      "gloss": 0.8,
      "border": "#0c3f87"
    },
    "chipSelectedText": "#ffffff",
    "navSelected": {
      "fill": {
        "linear": {
          "angle": 180,
          "colors": [
            "#2566c0",
            "#0c4190"
          ]
        }
      },
      "gloss": 0.6,
      "border": "#1b56a6"
    },
    "navSelectedText": "#ffffff",
    "navText": "#2b2f35"
  },
  "icons": {
    "style": "fill",
    "effect": "gel"
  },
  "cards": {
    "video": {
      "fill": "#ffffff",
      "border": "#c9c9c9",
      "shadow": [
        {
          "color": "#00000026",
          "y": 4,
          "blur": 12
        }
      ],
      "hover": {
        "border": {
          "color": "#3d8be6",
          "width": 2
        }
      },
      "focused": {
        "border": {
          "color": "#1660c4",
          "width": 3
        }
      }
    },
    "padding": 6,
    "panel": {
      "fill": "#ffffffee",
      "border": "#c3c3c3"
    },
    "durationBadge": {
      "fill": "#1a1a1acc",
      "radius": 99
    },
    "durationText": "#ffffff"
  },
  "logo": {
    "text": "Lumtub",
    "size": 24,
    "fill": {
      "linear": {
        "angle": 180,
        "colors": [
          "#5b6675",
          "#1f2833"
        ]
      }
    },
    "shadow": "#ffffff",
    "badge": {
      "fill": {
        "radial": {
          "center": [
            0.5,
            0.8
          ],
          "radius": 0.7,
          "colors": [
            "#8cc4ff",
            "#1356b3"
          ]
        }
      },
      "gloss": 0.85,
      "border": "#0c3f87"
    },
    "badgeIcon": "#ffffff"
  },
  "player": {
    "progress": {
      "linear": {
        "angle": 90,
        "colors": [
          "#5aa2f0",
          "#1660c4"
        ]
      }
    }
  },
  "author": "Lumtub",
  "license": "CC0-1.0"
}
