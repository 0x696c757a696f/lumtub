// Rice Paper: one of Lumtub's colour schemes as a skin. It follows the theme
// mode: "colors" are the light side, "overrides.dark" the dark one.
// 宣纸：Lumtub 的配色方案之一。跟随浅色/深色模式："colors" 是浅色，"overrides.dark" 是深色。
{
  "$schema": "https://raw.githubusercontent.com/0x696c757a696f/lumtub/main/skins/skin.schema.json",
  "lumtubSkin": 1,
  "id": "rice-paper",
  "name": "Rice Paper",
  "names": {
    "zh-Hans": "宣纸",
    "zh-Hant": "宣紙"
  },
  "description": "Warm paper with a vermilion seal and a deeper margin",
  "descriptions": {
    "zh-Hans": "暖白纸色配朱砂，页边略深",
    "zh-Hant": "暖白紙色搭配朱砂，頁邊略深"
  },
  "author": "Lumtub",
  "version": "1.0",
  "license": "CC0-1.0",
  "brightness": "auto",
  "colors": {
    "page": "#f4ecdc",
    "text": "#2a241c",
    "accent": "#a3402a",
    "chrome": "#eadfc8",
    "selected": "#e2d3b6"
  },
  "window": {
    "titleBar": {
      "height": 32
    },
    "menuBar": {}
  },
  "overrides": {
    "dark": {
      "colors": {
        "page": "#1e1a15",
        "text": "#eae1d0",
        "accent": "#db7a5e",
        "chrome": "#16130f",
        "selected": "#332b22"
      }
    }
  }
}
