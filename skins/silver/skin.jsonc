            "fill": "#1f56b0"
          }
        },
        "primaryButtonText": "#ffffff",
        "chip": {
          "fill": {
            "linear": {
              "angle": 180,
              "colors": [
                "#0f0f0f",
                "#272727"
              ]
            }
          },
          "border": "#595959"
        },
        "chipSelected": {
          "fill": {
            "linear": {
              "angle": 180,
              "colors": [
                "#1f68c4",
                "#0b3f8c"
              ]
            }
          },
          "gloss": 0.8,
          "border": "#0c3f87"
        },
        "chipSelectedText": "#ffffff",
        "navSelected": {
          "fill": {
            "linear": {
              "angle": 180,
              "colors": [
                "#3a68b2",
                "#2a589f"
              ]
            }
          },
          "border": {
            "color": "#3363b3",
            "sides": [
              "top"
            ]
          },
          "radius": 0
        },
        "navSelectedText": "#ffffff",
        "navText": "#b2bbc8"
      },
      "cards": {
        "video": {
          "fill": "#0f0f0f",
          "border": "#404040",
          "shadow": [
            {
              "color": "#0000001f",
              "y": 2,
              "blur": 6
            }
          ],
          "hover": {
            "border": {
              "color": "#5079ba",
              "width": 2
            }
          },
          "focused": {
            "border": {
              "color": "#4178c6",
              "width": 3
            }
          }
        },
        "padding": 6,
        "panel": {
          "fill": "#0f0f0fee",
          "border": "#434343"
        },
        "durationBadge": {
          "fill": "#1c1c1ccc",
          "radius": 4
        },
        "durationText": "#ffffff"
      },
      "logo": {
        "fill": {
          "linear": {
            "angle": 180,
            "colors": [
              "#858f9d",
              "#bcc6d3"
            ]
          }
        },
        "shadow": "#0f0f0f"
      }
    }
  }
}
