// Brushed Silver: a built-in Lumtub skin. skins/template/skin.jsonc explains every
// field, and skins/README.md how to make your own.
// 银色一体：Lumtub 内置皮肤。每个字段的说明见 skins/template/skin.jsonc，自己做皮肤见 skins/README.md。
{
  "$schema": "https://raw.githubusercontent.com/0x696c757a696f/lumtub/main/skins/skin.schema.json",
  "lumtubSkin": 1,
  "id": "silver",
  "name": "Brushed Silver",
  "names": {
    "zh-Hans": "银色一体",
    "zh-Hant": "銀色一體"
  },
  "description": "Smooth grey bars joined into one, a light menu bar along the top, red, amber and green buttons and a blue-grey sidebar, as desktops looked around 2008",
  "descriptions": {
    "zh-Hans": "灰色渐变的标题栏和工具栏连成一体，最上面是浅色菜单栏，红黄绿按钮，蓝灰侧栏，像 2008 年前后的桌面",
    "zh-Hant": "灰色漸層的標題列和工具列連成一體，最上面是淺色選單列，紅黃綠按鈕，藍灰側欄，像 2008 年前後的桌面"
  },
  "brightness": "light",
  "colors": {
    "page": "#ececec",
    "text": "#1c1c1c",
    "muted": "#555a61",
    "accent": "#2c6bc4",
    "onAccent": "#ffffff",
    "border": "#b5b5b5",
    "card": "#ffffff",
    "selected": "#d3e0f2",
    "onSelected": "#0f2a52",
    "reason": "#2c6bc4",
    "chrome": "#d6d6d6"
  },
  "shape": {
    "cardRadius": 6,
    "controlRadius": 5,
    "thumbnailRadius": 3
  },
  "window": {
    "background": [
      "#ececec"
    ],
    "titleBar": {
      "height": 24,
      "surface": {
        "fill": [
          {
            "linear": {
              "angle": 180,
              "colors": [
                "#e9e9e9",
                "#d0d0d0"
              ]
            }
          }
        ]
      },
      "inactive": {
        "fill": [
          {
            "linear": {
              "angle": 180,
              "colors": [
                "#f4f4f4",
                "#e6e6e6"
              ]
            }
          }
        ]
      },
      "text": "#1a1a1a",
      "inactiveText": "#6b6b6b",
      "align": "center",
      "icon": false,
      "buttons": {
        "placement": "left",
        "glyphs": "hover",
        "size": [
          13,
          13
        ],
        "icon": "#3b2a12",
        "surface": {
          "fill": {
            "radial": {
              "center": [
                0.5,
                0.8
              ],
              "radius": 0.7,
              "colors": [
                "#c9f2a8",
                "#4ea83a"
              ]
            }
          },
          "radius": 99,
          "gloss": 0.75,
          "border": "#2f7a22",
          "hover": {
            "fill": {
              "radial": {
                "center": [
                  0.5,
                  0.8
                ],
                "radius": 0.7,
                "colors": [
                  "#d8f8bd",
                  "#5cb948"
                ]
              }
            },
            "gloss": 0.75
          },
          "pressed": {
            "fill": "#3b8a2c"
          }
        },
        "minimize": {
          "fill": {
            "radial": {
              "center": [
                0.5,
                0.8
              ],
              "radius": 0.7,
              "colors": [
                "#ffe9a6",
                "#e0a225"
              ]
            }
          },
          "radius": 99,
          "gloss": 0.75,
          "border": "#a8740f",
          "hover": {
            "fill": {
              "radial": {
                "center": [
                  0.5,
                  0.8
                ],
                "radius": 0.7,
                "colors": [
                  "#fff0bf",
                  "#eab03a"
                ]
              }
            },
            "gloss": 0.75
          },
          "pressed": {
            "fill": "#c08718"
          }
        },
        "close": {
          "fill": {
            "radial": {
              "center": [
                0.5,
                0.8
              ],
              "radius": 0.7,
              "colors": [
                "#ffb3aa",
                "#d9473b"
              ]
            }
          },
          "radius": 99,
          "gloss": 0.75,
          "border": "#a52b22",
          "hover": {
            "fill": {
              "radial": {
                "center": [
                  0.5,
                  0.8
                ],
                "radius": 0.7,
                "colors": [
                  "#ffc4bc",
                  "#e45a4e"
                ]
              }
            },
            "gloss": 0.75
          },
          "pressed": {
            "fill": "#b8332a"
          }
        }
      }
    },
    "menuBar": {
      "position": "top",
      "appMenu": true,
      "underlineKeys": false,
      "height": 22,
      "surface": {
        "fill": [
          {
            "linear": {
              "angle": 180,
              "colors": [
                "#fbfbfbf0",
                "#e3e3e3f0"
              ]
            }
          }
        ],
        "border": {
          "color": "#9d9d9d",
          "sides": [
            "bottom"
          ]
        }
      },
      "text": "#1a1a1a",
      "highlight": {
        "fill": {
          "linear": {
            "angle": 180,
            "colors": [
              "#3f72cf",
              "#2a5fc4"
            ]
          }
        }
      },
      "highlightText": "#ffffff",
      "menu": {
        "fill": "#fbfbfbf2",
        "border": "#a8a8a8",
        "radius": 6,
        "shadow": [
          {
            "color": "#00000040",
            "y": 6,
            "blur": 16
          }
        ]
      },
      "clock": true
    },
    "topBar": {
      "fill": [
        {
          "linear": {
            "angle": 180,
            "colors": [
              "#d0d0d0",
              "#a9a9a9"
            ]
          }
        }
      ],
      "border": {
        "color": "#555555",
        "sides": [
          "bottom"
        ]
      }
    },
    "sideBar": {
      "fill": "#dde3ea",
      "border": {
        "color": "#a3a9b0",
        "sides": [
          "right"
        ]
      }
    },
    "topBarText": "#1c1c1c"
  },
  "controls": {
    "button": {
      "fill": {
        "linear": {
          "angle": 180,
          "colors": [
            "#ffffff",
            "#e8e8e8"
          ]
        }
      },
      "border": "#9a9a9a",
      "shadow": [
        {
          "color": "#00000026",
          "y": 1,
          "blur": 1
        }
      ],
      "hover": {
        "fill": {
          "linear": {
            "angle": 180,
            "colors": [
              "#ffffff",
              "#f2f2f2"
            ]
          }
        }
      },
      "pressed": {
        "fill": {
          "linear": {
            "angle": 180,
            "colors": [
              "#d7d7d7",
              "#e6e6e6"
            ]
          }
        }
      }
    },
    "buttonText": "#1a1a1a",
    "primaryButton": {
      "fill": {
        "linear": {
          "angle": 180,
          "colors": [
            "#2b66c0",
            "#2563c8"
          ]
        }
      },
      "gloss": 0.55,
      "border": "#1f4f9c",
      "hover": {
        "fill": {
          "linear": {
            "angle": 180,
            "colors": [
              "#336fca",
              "#2c6bd0"
            ]
          }
        },
        "gloss": 0.55
      },
      "pressed": {
        "fill": "#1f56b0"
      }
    },
    "primaryButtonText": "#ffffff",
    "chip": {
      "fill": {
        "linear": {
          "angle": 180,
          "colors": [
            "#ffffff",
            "#e4e4e4"
          ]
        }
      },
      "border": "#a9a9a9"
    },
    "chipSelected": {
      "fill": {
        "linear": {
          "angle": 180,
          "colors": [
            "#1f68c4",
            "#0b3f8c"
          ]
        }
      },
      "gloss": 0.8,
      "border": "#0c3f87"
    },
    "chipSelectedText": "#ffffff",
    "navSelected": {
      "fill": {
        "linear": {
          "angle": 180,
          "colors": [
            "#3a68b2",
            "#2a589f"
          ]
        }
      },
      "border": {
        "color": "#3363b3",
        "sides": [
          "top"
        ]
      },
      "radius": 0
    },
    "navSelectedText": "#ffffff",
    "navText": "#2b3440"
  },
  "icons": {
    "style": "fill",
    "effect": "emboss"
  },
  "cards": {
    "video": {
      "fill": "#ffffff",
      "border": "#c6c6c6",
      "shadow": [
        {
          "color": "#0000001f",
          "y": 2,
          "blur": 6
        }
      ],
      "hover": {
        "border": {
          "color": "#3a68b2",
          "width": 2
        }
      },
      "focused": {
        "border": {
          "color": "#2c6bc4",
          "width": 3
        }
      }
    },
    "padding": 6,
    "panel": {
      "fill": "#ffffffee",
      "border": "#c3c3c3"
    },
    "durationBadge": {
      "fill": "#1c1c1ccc",
      "radius": 4
    },
    "durationText": "#ffffff"
  },
  "logo": {
    "text": "Lumtub",
    "size": 24,
    "fill": {
      "linear": {
        "angle": 180,
        "colors": [
          "#5b6675",
          "#1f2833"
        ]
      }
    },
    "shadow": "#ffffff",
    "badge": {
      "fill": {
        "radial": {
          "center": [
            0.5,
            0.8
          ],
          "radius": 0.7,
          "colors": [
            "#9cc6f5",
            "#2a64bf"
          ]
        }
      },
      "gloss": 0.7,
      "border": "#1f4f9c"
    },
    "badgeIcon": "#ffffff"
  },
  "player": {
    "progress": {
      "linear": {
        "angle": 90,
        "colors": [
          "#7aa8e6",
          "#2c6bc4"
        ]
      }
    }
  },
  "author": "Lumtub",
  "license": "CC0-1.0"
}
